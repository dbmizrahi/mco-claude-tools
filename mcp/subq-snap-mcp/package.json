{
  "name": "subq-snap-mcp",
  "version": "0.1.0",
  "description": "MCP server for the SubQ Snap decision model, packaged as a Claude desktop extension (.mcpb).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "dbmizrahi",
    "url": "https://github.com/dbmizrahi"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist-test/test/**/*.test.js\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
